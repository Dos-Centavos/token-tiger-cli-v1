# Token Tiger CLI — copy to .env and adjust (never commit secrets)

# Base URL for API calls (optional; has a safe default in config)
# TOKEN_TIGER_API_BASE_URL=https://api.example.com

# Default bearer/API token when a command does not pass --token (optional)
# TOKEN_TIGER_TOKEN=

# Logging verbosity: debug | info | warn | error
# TOKEN_TIGER_LOG_LEVEL=info
